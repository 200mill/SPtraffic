# data.go.kr API
DATAGOKR_API_KEY=your_key_here

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sptraffic
DB_USER=sptraffic
DB_PASSWORD=changeme

# Redis
REDIS_ADDR=localhost:6379

# Server
SERVER_PORT=8080
CORS_ORIGIN=http://localhost:5173
MIGRATIONS_DIR=./migrations

# Admin endpoints (POST /api/admin/ingest, GET /api/admin/status)
# Leave empty to disable admin endpoints entirely.
ADMIN_KEY=change-this-secret

# Seoul Open Data Plaza API key for real-time metro arrivals
# Register at https://data.seoul.go.kr to get a key.
# Leave empty to disable real-time metro (GET /api/terminals/:code/realtime returns []).
SEOUL_METRO_KEY=

# Ports (optional — defaults shown)
SERVER_PORT=8080
FRONTEND_PORT=3000
